<UserControl x:Class="WinUIBatchPacker.MediaListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="18,14" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderBlock"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Opacity="0.9"
                           VerticalAlignment="Center"/>
                <ProgressRing x:Name="RefreshRing"
                              Grid.Column="1"
                              Width="28" Height="28"
                              Visibility="Collapsed"
                              IsActive="False"/>
                <Button x:Name="RefreshBtn"
                        Grid.Column="1"
                        Width="32" Height="32"
                        CornerRadius="16"
                        Padding="0"
                        Click="Refresh_Click"
                        ToolTipService.ToolTip="刷新列表">
                    <Button.Content>
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button.Content>
                </Button>
                <CheckBox x:Name="SelectAllCheck"
                          Grid.Column="2"
                          Content="全选"
                          IsChecked="True"
                          Click="SelectAll_Click"/>
            </Grid>

            <!-- Column headers -->
            <Border Grid.Row="1"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,1">
                <Grid Margin="12,10,12,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="序号" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.6" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="使用" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.6" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="文件名" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.6" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="集号" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0.6" FontSize="12" Margin="0,0,20,0"/>
                </Grid>
            </Border>

            <!-- Items list -->
            <ListView x:Name="RowsList"
                      Grid.Row="2"
                      CanDragItems="True"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="RowsList_DragItemsCompleted"
                      SelectionMode="Single"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,9,12,9"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#33000000">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="92"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="#FF0078D4"/>
                                <CheckBox Grid.Column="1"
                                          Width="20" Height="20"
                                          MinWidth="20" MinHeight="20"
                                          Padding="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Click="ItemCheckBox_Click"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DisplayName}"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           FontSize="13"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding EpisodeDisplay}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,20,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FF0078D4"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Move buttons -->
            <Border Grid.Row="3"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10">
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <Button Content="↑ 上移" Click="Up_Click" CornerRadius="8"/>
                    <Button Content="↓ 下移" Click="Down_Click" CornerRadius="8"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>