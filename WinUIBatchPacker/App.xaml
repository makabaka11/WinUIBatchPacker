<Application x:Class="WinUIBatchPacker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="CardRadius">12</CornerRadius>
            <CornerRadius x:Key="ControlRadius">8</CornerRadius>
            <Thickness x:Key="CardPadding">20</Thickness>
            <x:Double x:Key="CardShadowOpacity">0.08</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>